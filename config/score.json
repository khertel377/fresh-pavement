{
  "_note": "Skate score constants. All source → band mappings live here. Edit to retune without touching code.",

  "band_order": ["fresh", "excellent", "good", "fair", "poor", "very_poor", "failed"],

  "bands": {
    "fresh":     { "score": 97, "label": "Fresh pavement",        "color": "#00e8b0" },
    "excellent": { "score": 88, "label": "Excellent — glassy",    "color": "#3ee6a0" },
    "good":      { "score": 76, "label": "Good — smooth",         "color": "#9fd67a" },
    "fair":      { "score": 62, "label": "Fair — rideable",       "color": "#e3c14f" },
    "poor":      { "score": 45, "label": "Poor — pick your line", "color": "#c2703d" },
    "very_poor": { "score": 28, "label": "Very poor — avoid",     "color": "#a0422a" },
    "failed":    { "score": 10, "label": "Failed — no",           "color": "#7a2020" }
