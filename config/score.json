    "mill_overlay": { "start": "fresh",     "step_years": 3 },
    "reconstruct":  { "start": "fresh",     "step_years": 3 },
    "hipr":         { "start": "excellent", "step_years": 3 },
    "slurry_seal":  { "start": "fair",      "step_years": 3 },
    "chip_seal":    { "start": "poor",      "step_years": 3, "cap": "poor" },
    "concrete":     { "start": "fair",      "step_years": 5 }
  },

  "_pci_note": "Standard ASTM D6433 bands for PCI and OCI (0–100).",
